{
  "name": "db-diff",
  "version": "0.1.0",
  "description": "Compares schemas and row-count distributions between two Postgres databases and suggests a migration script.",
  "bin": {
    "db-diff": "./dist/index.js"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "mysql2": "^3.24.4",
    "pg": "^8.12.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
